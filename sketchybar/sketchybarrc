#!/bin/bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

# Palette.
WHITE=0xffffffff
BAR_BG=0x40373454
BAR_BORDER=0xff373454
ITEM_BG=0xc0373465
POPUP_BG=0xff373465

# Fonts.
FONT_ICON="SF Pro:Semibold:14.0"
FONT_LABEL="SF Mono:Bold:14.0"

# Bar geometry and appearance.
sketchybar --bar \
  position=top \
  height=36 \
  blur_radius=15 \
  color=$BAR_BG \
  border_color=$BAR_BORDER \
  border_width=1 \
  corner_radius=10 \
  margin=8 \
  y_offset=8 \
  padding_left=4 \
  padding_right=4

# Defaults inherited by every item.
default=(
  padding_left=0
  padding_right=0
  icon.font="$FONT_ICON"
  label.font="$FONT_LABEL"
  icon.color=$WHITE
  label.color=$WHITE
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

# Shared rounded pill background for items.
item=(
  background.color=$ITEM_BG
  background.corner_radius=6
  background.height=28
  icon.padding_left=12
  label.padding_right=12
)

# Left: focused application name.
sketchybar --add item front_app left \
           --set front_app "${item[@]}" \
                 icon.drawing=on \
                 script="$PLUGIN_DIR/front_app.sh" \
                 padding_left=0 \
                 align=center \
           --subscribe front_app front_app_switched

# Right: clock, volume, battery, network.
sketchybar --add item clock right \
           --set clock "${item[@]}" \
                 script="$PLUGIN_DIR/clock/clock.sh" \
                 padding_right=0 \
           --add item volume right \
           --set volume "${item[@]}" \
                 script="$PLUGIN_DIR/volume.sh" \
                 padding_right=3 \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery "${item[@]}" \
                 update_freq=120 \
                 script="$PLUGIN_DIR/battery.sh" \
                 padding_right=3 \
           --subscribe battery system_woke power_source_change \
           --add item network right \
           --set network "${item[@]}" \
                 script="$PLUGIN_DIR/network.sh" \
                 update_freq=2 \
                 click_script="sketchybar --set network popup.drawing=toggle" \
                 popup.align=center \
                 popup.background.color=$POPUP_BG \
                 popup.background.corner_radius=6 \
                 popup.background.border_width=1 \
                 popup.background.border_color=$BAR_BORDER \
                 padding_right=3 \
           --subscribe network wifi_change

# Network popup rows: live down/up rates, toggled by clicking the item.
# Fixed width keeps the popup from resizing as the rate values change.
sketchybar --add item network.down popup.network \
           --set network.down icon=↓ label=0B width=110 \
           --add item network.up popup.network \
           --set network.up icon=↑ label=0B width=110

# CPU usage graph; the cpu_load helper pushes utilization to it every tick.
sketchybar --add graph cpu right 42 \
           --set cpu "${item[@]}" \
                 graph.color=$WHITE \
                 icon.width=64 \
                 icon.align=left \
                 click_script="open -a 'Activity Monitor'" \
                 padding_right=3

# Build the C plugins.
cd "$PLUGIN_DIR" && make

# Start the CPU load helper (pushes utilization to the cpu graph every 2s).
killall cpu_load 2>/dev/null
"$PLUGIN_DIR/cpu/bin/cpu_load" 2.0 &

# Run every item script once on load.
sketchybar --update

sketchybar --hotload true
